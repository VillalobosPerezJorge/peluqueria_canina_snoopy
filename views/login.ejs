<!DOCTYPE html>
<html lang="en">

<head>
  <title>Peluquería Canina Snoopy - Iniciar sesión</title>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/public/css/style.css">

  <!-- Navigation bar -->
  <%- include('./partials/navigation.ejs') %>
    <!-- Navigation bar -->

    <div class="container py-5">
      <div class="container mt-5 form-container">
        <h2 id="title" class="my-5 fw-bold title text-center">Iniciar sesión</h2>
        <p style="font-size: x-large;">Ingrese sus credenciales para iniciar sesión.</p>

        <form>
          <div class="mb-3">
            <label for="email" class="form-label" style="font-size: larger;">Correo electrónico ó Username:</label>
            <input type="email" class="form-control" id="login_email" placeholder="Ingrese su correo electrónico o username"
              required>
          </div>
          <div class="mb-3">
            <label for="exampleInputPassword1" class="form-label" style="font-size: larger;">Contraseña</label>
            <input type="password" class="form-control" id="login_password" required>
          </div>
          <br>
          <div class="checkbox">
            <a href="./password-recovery">¿Olvidaste tu contraseña?</a>
            <br><br>
            <label>
              <input type="checkbox" id="remember" name="remember"> Recuérdame
            </label>
          </div>
          <br>
          <div>
            <button type="button" id="btn-login" class="btn btn-primary">Ingresar</button>
          </div>
          <br>
        </form>
      </div>

    </div>
    <!-- Footer -->
    <%- include('./partials/footer.ejs') %>
      <!-- Fin Footer -->

      <!-- JavaScript dependencies -->
      <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
      <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>

      <!-- scripts generales para todas las vistas -->
      <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
      <script src="../public/js/general-user.js"></script>

      <script src="../public/js/login.js"></script>
</body>

</html>