<!DOCTYPE html>
<html lang="en">

<head>
  <title>Peluquería Canina Ángeles Peluditos</title>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet">
  
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">

  <link rel="stylesheet" href="../public/css/index.css">


<!-- Navigation bar -->
  <%- include('./partials/navigation.ejs') %>
<!-- Navigation bar -->


<div class="container principal">
  <div id="main" class="container py-5">
  
    <!-- Carrusel -->
    <h1 class="title text-center my-5">Bienvenido a Ángeles Peluditos!</h1>
    <h2 class="title small text-center my-5">Peluquería Canina</h2>
  
    <div id="carouselDiv" class="mx-auto mb-5">
      <div id="carouselExampleIndicators" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-indicators">

        </div>
        <div class="carousel-inner">
          <div class="carousel-item active">
            <img src="https://angelespeluditos.cl/api//api/banner/showimage" class="d-block w-100" alt="default image" id="carousel_1">
          </div>
        </div>

        <button class="carousel-control-prev hidden_btn" name="prev" type="button" data-bs-target="#carouselExampleIndicators"
          data-bs-slide="prev">
          <span class="carousel-control-prev-icon" aria-hidden="true"></span>
          <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next hidden_btn" name="next" type="button" data-bs-target="#carouselExampleIndicators"
          data-bs-slide="next">
          <span class="carousel-control-next-icon" aria-hidden="true"></span>
          <span class="visually-hidden">Next</span>
        </button>
      </div>
    </div>
    <!-- Fin Carrusel -->
  
    <!-- Perro del mes -->
    <div class="container-fluid pb-5">
      <div class="col-lg-12 text-center my-2">
        <h1 class="title">Nuestro perrito del mes</h1>
        <h2 class="mb-5" style="color: #DA0E83;">
          ¡Descubre si tu peludito es nuestro destacado del mes!
        </h2>
      </div>
      <div class="row justify-content-center pb-2">
        <div class="col-md-10">
          <div class="row">
            <div class="col-md-8" id="perro-del-mes">
              <img class="img-fluid" src="https://www.angelespeluditos.cl/api/api/post/showimage" alt="Perro del mes" style="border-radius: 15px;">
            </div>
            <div class="col-md-4 d-flex flex-column justify-content-center">
              <div id="nombre-perro" class="mb-3 text-center"></div>
              <div id="datos-perro" class="mb-3 text-center"></div> 
            </div>
          </div>
        </div>
      </div>
    </div>
    <!-- Fin perro del mes -->
    </div>

</div>
    <!-- Footer -->
    <%- include('./partials/footer.ejs') %>
    <!-- Fin Footer -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="../public/js/general-user.js"></script>

    <!-- Script para funcionamiento del banner/Perro del mes-->
    <script src="../public/js/index.js"></script>

</body>

</html>
